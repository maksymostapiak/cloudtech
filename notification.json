{
  "LambdaFunctionConfigurations": [
    {
      "Id": "TriggerOnIncomingUpload",
      "LambdaFunctionArn": "arn:aws:lambda:us-east-1:000000000000:function:S3FileProcessor",
      "Events": ["s3:ObjectCreated:*"],
      "Filter": {
        "Key": {
          "FilterRules": [
            { "Name": "prefix", "Value": "incoming/" }
          ]
        }
      }
    }
  ]
}